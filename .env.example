# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.1
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_MONTHLY_BUDGET_USD=50

# Browser (Chrome real do operador, via CDP)
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PROFILE_DIR=./.chrome-profile

# Instagram — API oficial (Meta)
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Banco
DATABASE_URL=file:./data/app.db

# Ritmo de envio (saúde da conta)
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Sao_Paulo

# Ritmo de descoberta (navegar hashtag/perfis é mais leve que DM, mas
# ainda precisa de limite e atraso — conta nova, comece conservador)
MAX_PROFILE_VISITS_PER_DAY=80
DISCOVERY_MIN_SECONDS_BETWEEN_ACTIONS=4
DISCOVERY_MAX_SECONDS_BETWEEN_ACTIONS=10
